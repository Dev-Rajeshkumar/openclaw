{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "name": "Tag",
    "description": "Content tags for taxonomy"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 50
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    }
  }
}
