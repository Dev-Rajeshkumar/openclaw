<mjml>
  <mj-head>
    <mj-title>Welcome to Our Newsletter</mj-title>
    <mj-preview>Thanks for subscribing! Here's what to expect.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, sans-serif" />
      <mj-text font-size="16px" line-height="24px" color="#333" />
      <mj-button background-color="#0284c7" color="#fff" border-radius="6px" font-weight="600" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-section padding="20px 0">
      <mj-column>
        <mj-image width="120px" src="{{logoUrl}}" alt="CMS Platform" align="center" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="8px" padding="40px 30px">
      <mj-column>
        <mj-text font-size="28px" font-weight="bold" align="center" color="#0f172a">
          Welcome! 🎉
        </mj-text>

        <mj-text font-size="18px" color="#475569" align="center">
          Hi {{name}}, thanks for subscribing to our newsletter.
        </mj-text>

        <mj-text color="#64748b">
          Here's what you can expect:
        </mj-text>

        <mj-table>
          <tr style="border-bottom: 1px solid #e2e8f0;">
            <td style="padding: 12px 0;"><strong>📰 Weekly Digest</strong></td>
            <td style="padding: 12px 0; color: #64748b;">Curated tech articles every week</td>
          </tr>
          <tr style="border-bottom: 1px solid #e2e8f0;">
            <td style="padding: 12px 0;"><strong>🚀 Product Updates</strong></td>
            <td style="padding: 12px 0; color: #64748b;">New features and improvements</td>
          </tr>
          <tr style="border-bottom: 1px solid #e2e8f0;">
            <td style="padding: 12px 0;"><strong>💡 Tutorials</strong></td>
            <td style="padding: 12px 0; color: #64748b;">In-depth guides and how-tos</td>
          </tr>
          <tr>
            <td style="padding: 12px 0;"><strong>🎯 Community</strong></td>
            <td style="padding: 12px 0; color: #64748b;">Highlights from our community</td>
          </tr>
        </mj-table>

        <mj-button href="{{blogUrl}}" padding="20px 0">
          Explore Latest Posts
        </mj-button>

        <mj-divider border-color="#e2e8f0" padding="20px 0" />

        <mj-text font-size="14px" color="#94a3b8" align="center">
          You're receiving this because you subscribed to our newsletter.
          <br />
          <a href="{{unsubscribeUrl}}" style="color: #64748b;">Unsubscribe</a> |
          <a href="{{preferencesUrl}}" style="color: #64748b;">Manage Preferences</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 0">
      <mj-column>
        <mj-text font-size="12px" color="#94a3b8" align="center">
          © {{year}} CMS Platform. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
