generator client { provider = "prisma-client-js" }
datasource db { provider = "mongodb"; url = env("DATABASE_URL") }
model User { id String @id @default(auto()) @map("_id") @db.ObjectId; email String @unique; name String?; avatar String?; plan Plan @default(FREE); formLimit Int @default(3) @map("form_limit"); submissionLimit Int @default(100) @map("submission_limit"); apiKey String? @unique; stripeCustomerId String? @map("stripe_customer_id"); settings Json @default("{}"); forms Form[]; activities ActivityLog[]; alerts Alert[]; createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); @@map("users") }
enum Plan { FREE PRO ENTERPRISE }
model Form { id String @id @default(auto()) @map("_id") @db.ObjectId; userId String @map("user_id") @db.ObjectId; user User @relation(fields:[userId],references:[id],onDelete:Cascade); name String; slug String @unique; description String?; destinationEmail String? @map("destination_email"); isActive Boolean @default(true) @map("is_active"); submitCount Int @default(0) @map("submit_count"); redirectUrl String? @map("redirect_url"); honeypotEnabled Boolean @default(true) @map("honeypot_enabled"); turnstileSiteKey String? @map("turnstile_site_key"); customCss String? @map("custom_css"); whiteLabel Boolean @default(false) @map("white_label"); fields Json @default("[]"); settings Json @default("{}"); aiPrompt String? @map("ai_prompt"); spamFilters Json @default("{}"); submissions Submission[]; webhooks Webhook[]; integrations Integration[]; payments Payment[]; createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); @@index([userId]); @@index([slug]); @@map("forms") }
model Submission { id String @id @default(auto()) @map("_id") @db.ObjectId; formId String @map("form_id") @db.ObjectId; form Form @relation(fields:[formId],references:[id],onDelete:Cascade); data Json @default("{}"); ipAddress String? @map("ip_address"); userAgent String? @map("user_agent"); isSpam Boolean @default(false); spamScore Float @default(0) @map("spam_score"); geoLocation Json?; processedAt DateTime?; createdAt DateTime @default(now()) @map("created_at"); @@index([formId]); @@index([createdAt]); @@map("submissions") }
model Webhook { id String @id @default(auto()) @map("_id") @db.ObjectId; formId String @map("form_id") @db.ObjectId; form Form @relation(fields:[formId],references:[id],onDelete:Cascade); url String; secret String; events String[] @default(["form.submitted"]); isActive Boolean @default(true) @map("is_active"); createdAt DateTime @default(now()) @map("created_at"); @@index([formId]); @@map("webhooks") }
model Integration { id String @id @default(auto()) @map("_id") @db.ObjectId; formId String @map("form_id") @db.ObjectId; form Form @relation(fields:[formId],references:[id],onDelete:Cascade); type String; config Json @default("{}"); isActive Boolean @default(true) @map("is_active"); createdAt DateTime @default(now()) @map("created_at"); @@index([formId]); @@map("integrations") }
model Payment { id String @id @default(auto()) @map("_id") @db.ObjectId; formId String @map("form_id") @db.ObjectId; form Form @relation(fields:[formId],references:[id],onDelete:Cascade); submissionId String? @map("submission_id") @db.ObjectId; amount Int; currency String @default("usd"); status PaymentStatus @default(PENDING); gateway String; gatewayPaymentId String? @map("gateway_payment_id"); metadata Json @default("{}"); createdAt DateTime @default(now()) @map("created_at"); @@index([formId]); @@map("payments") }
enum PaymentStatus { PENDING COMPLETED FAILED REFUNDED }
model ActivityLog { id String @id @default(auto()) @map("_id") @db.ObjectId; userId String? @map("user_id") @db.ObjectId; action String; entity String?; entityId String? @map("entity_id"); metadata Json @default("{}"); ipAddress String? @map("ip_address"); userAgent String? @map("user_agent"); createdAt DateTime @default(now()) @map("created_at"); @@index([userId]); @@index([action]); @@index([createdAt]); @@map("activity_logs") }
model Alert { id String @id @default(auto()) @map("_id") @db.ObjectId; userId String? @map("user_id") @db.ObjectId; type String; severity String; message String; metadata Json @default("{}"); isRead Boolean @default(false) @map("is_read"); createdAt DateTime @default(now()) @map("created_at"); @@index([userId,isRead]); @@map("alerts") }
