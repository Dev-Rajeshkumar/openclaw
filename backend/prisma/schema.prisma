generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique
  password        String?
  fullName        String
  avatar          String?
  googleId        String?   @unique
  isEmailVerified Boolean   @default(false)
  phone           String?
  currency        String    @default("INR")
  language        String    @default("en")
  timezone        String    @default("Asia/Kolkata")
  plan            Plan      @default(Free)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  businesses       Business[]
  clients          Client[]
  products         Product[]
  services         Service[]
  estimates        Estimate[]
  invoices         Invoice[]
  recurringInvoices RecurringInvoice[]
  payments         Payment[]
  expenses         Expense[]
  activityLogs     ActivityLog[]
  statusLogs       StatusLog[]    @relation("StatusLogChangedBy")
  teamMemberships  TeamMember[]
  invitationsSent  Invitation[]    @relation("InvitationInvitedBy")
  files            File[]
  notifications    Notification[]
  subscription     Subscription?
  apiKeys          ApiKey[]
  notificationPreference NotificationPreference?

  @@map("users")
}

model Business {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  name           String
  gstNumber      String?
  pan            String?
  phone          String?
  address        String?
  logo           String?
  invoicePrefix  String    @default("INV")
  nextInvoiceNo  Int       @default(1)
  razorpayKeyId  String?
  razorpayKeySecret String?
  razorpayEnabled Boolean @default(false)
  primaryColor   String?   @default("#f59e0b")
  accentColor    String?   @default("#1a1a2e")
  customDomain   String?
  whiteLabelEnabled Boolean @default(false)
  emailFromName  String?
  emailReplyTo   String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  clients         Client[]
  products        Product[]
  services        Service[]
  estimates       Estimate[]
  invoices        Invoice[]
  recurringInvoices RecurringInvoice[]
  expenses        Expense[]
  teamMembers     TeamMember[]
  invitations     Invitation[]
  files           File[]
  invoiceTemplates InvoiceTemplate[]

  @@map("businesses")
}

model Client {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  userId           String      @db.ObjectId
  businessId       String      @db.ObjectId
  name             String
  company          String?
  email            String?
  phone            String?
  gstNumber        String?
  pan              String?
  billingAddress   String?
  shippingAddress  String?
  notes            String?
  tags             String[]
  status           ClientStatus @default(Active)
  magicToken       String?
  magicTokenExpires DateTime?
  deletedAt        DateTime?
  createdBy        String      @db.ObjectId
  updatedAt        DateTime    @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  business  Business  @relation(fields: [businessId], references: [id])
  estimates Estimate[]
  invoices  Invoice[]
  recurringInvoices RecurringInvoice[]

  @@map("clients")
}

model Product {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  businessId  String    @db.ObjectId
  name        String
  sku         String?
  hsnCode     String?
  description String?
  unitPrice   Float
  taxRate     Float     @default(0)
  category    String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@map("products")
}

model Service {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  businessId  String    @db.ObjectId
  name        String
  description String?
  hourlyRate  Float?
  fixedRate   Float?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@map("services")
}

model Estimate {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  userId         String          @db.ObjectId
  businessId     String          @db.ObjectId
  clientId       String          @db.ObjectId
  estimateNumber String
  title          String
  items          Json
  subtotal       Float
  taxAmount      Float           @default(0)
  total          Float
  status         EstimateStatus  @default(Draft)
  expiryDate     DateTime?
  notes          String?
  terms          String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])

  @@map("estimates")
}

model Invoice {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  userId         String          @db.ObjectId
  businessId     String          @db.ObjectId
  clientId       String?         @db.ObjectId
  recurringId    String?         @db.ObjectId
  invoiceNumber  String
  invoiceDate    DateTime        @default(now())
  dueDate        DateTime
  items          Json
  subtotal       Float
  discountAmount Float           @default(0)
  taxAmount      Float           @default(0)
  total          Float
  status         InvoiceStatus   @default(Draft)
  invoiceTemplateId String?    @db.ObjectId
  templateTextOverrides Json?
  publicAccessToken String?  @unique
  viewCount       Int            @default(0)
  lastViewedAt    DateTime?
  notes          String?
  terms          String?
  deletedAt      DateTime?
  createdBy      String          @db.ObjectId
  updatedAt      DateTime        @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  business        Business         @relation(fields: [businessId], references: [id])
  client          Client?          @relation(fields: [clientId], references: [id])
  recurringInvoice RecurringInvoice? @relation(fields: [recurringId], references: [id])
  payments        Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String          @db.ObjectId
  type        InvoiceItemType
  description String
  hsnCode     String?
  quantity    Float
  rate        Float
  discount    Float           @default(0)
  taxRate     Float           @default(0)
  amount      Float
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())

  @@map("invoice_items")
}

model RecurringInvoice {
  id         String              @id @default(auto()) @map("_id") @db.ObjectId
  userId     String              @db.ObjectId
  businessId String              @db.ObjectId
  clientId   String              @db.ObjectId
  template   Json
  frequency  RecurringFrequency
  startDate  DateTime
  endDate    DateTime?
  nextRun    DateTime
  autoSend   Boolean             @default(false)
  deletedAt  DateTime?
  createdAt  DateTime            @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  invoices Invoice[]

  @@map("recurring_invoices")
}

model Payment {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId        String        @db.ObjectId
  userId           String        @db.ObjectId
  amount           Float
  method           PaymentMethod
  reference        String?
  notes            String?
  status           PaymentStatus @default(Completed)
  paidAt           DateTime?
  razorpayOrderId  String?
  razorpayPaymentId String?
  razorpaySignature String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("payments")
}

model Expense {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  businessId  String    @db.ObjectId
  category    String
  amount      Float
  description String?
  receiptUrl  String?
  date        DateTime  @default(now())
  taxAmount   Float?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@map("expenses")
}

model ActivityLog {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  action     String
  entity     String
  entityId   String?
  method     String
  path       String
  statusCode Int?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model StatusLog {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  entity      String
  entityId    String
  action      String
  oldValue    String?
  newValue    String?
  description String?
  changedBy   String    @db.ObjectId
  metadata    Json?
  createdAt   DateTime  @default(now())

  user User @relation("StatusLogChangedBy", fields: [changedBy], references: [id])

  @@map("status_logs")
}

model TeamMember {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  businessId  String       @db.ObjectId
  userId      String       @db.ObjectId
  role        TeamRole     @default(Employee)
  permissions String[]
  invitedBy   String       @db.ObjectId
  joinedAt    DateTime     @default(now())
  deletedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@map("team_members")
}

model Invitation {
  id         String             @id @default(auto()) @map("_id") @db.ObjectId
  businessId String             @db.ObjectId
  email      String
  role       TeamRole
  invitedBy  String             @db.ObjectId
  token      String             @unique
  expiresAt  DateTime
  status     InvitationStatus   @default(Pending)
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id])
  inviter  User     @relation("InvitationInvitedBy", fields: [invitedBy], references: [id])

  @@map("invitations")
}

model InvoiceTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId  String   @db.ObjectId
  name        String
  slug        String
  description String
  isDefault   Boolean  @default(false)
  isPremium  Boolean  @default(false)
  layout      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, slug])
  @@map("invoice_templates")
}

model File {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  businessId String    @db.ObjectId
  entityType String
  entityId   String
  fileName   String
  fileUrl    String
  mimeType   String
  size       Int
  uploadedBy String    @db.ObjectId
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@map("files")
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Subscription {
  id                   String            @id @default(auto()) @map("_id") @db.ObjectId
  userId               String            @unique @db.ObjectId
  plan                 Plan              @default(Free)
  status               SubscriptionStatus @default(Active)
  currentPeriodStart   DateTime          @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean           @default(false)
  paymentMethod        String?
  createdAt            DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

enum Plan {
  Free
  Starter
  Professional
  Business
}

enum ClientStatus {
  Active
  Inactive
  Archived
}

enum EstimateStatus {
  Draft
  Sent
  Accepted
  Rejected
  Expired
}

enum InvoiceStatus {
  Draft
  Sent
  Viewed
  PartiallyPaid
  Paid
  Overdue
  Cancelled
}

enum InvoiceItemType {
  Product
  Service
  Custom
}

enum RecurringFrequency {
  Daily
  Weekly
  Monthly
  Quarterly
  Yearly
}

enum PaymentMethod {
  Cash
  BankTransfer
  UPI
  Card
  Cheque
  Online
  Other
}

enum PaymentStatus {
  Pending
  Completed
  Failed
  Refunded
}

enum TeamRole {
  Owner
  Admin
  Accountant
  Manager
  Employee
  Viewer
}

enum InvitationStatus {
  Pending
  Accepted
  Rejected
  Expired
}

enum NotificationType {
  Invoice
  Payment
  System
  Reminder
}

enum SubscriptionStatus {
  Active
  Inactive
  Cancelled
  PastDue
}

model ApiKey {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id])
  name       String
  keyHash    String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@map("api_keys")
}

model NotificationPreference {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  emailInvoice  Boolean  @default(true)
  emailPayment  Boolean  @default(true)
  emailReminder Boolean  @default(true)
  emailTeam     Boolean  @default(true)
  pushInvoice   Boolean  @default(true)
  pushPayment   Boolean  @default(true)
  pushReminder  Boolean  @default(true)
  pushTeam      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("notification_preferences")
}

model InvoiceViewLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId  String   @db.ObjectId
  ipAddress  String?
  userAgent  String?
  viewedAt   DateTime @default(now())

  @@map("invoice_view_logs")
}
