generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ==================== USER MODEL ====================

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  password      String
  fullName      String
  businessName  String?
  gstNumber     String?
  phone         String?
  address       String?
  plan          String   @default("FREE")
  invoiceCount  Int      @default(0)
  clientCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clients  Client[]
  invoices Invoice[]
  payments Payment @@map("userpayments")

  @@map("users")
}

// ==================== CLIENT MODEL ====================

model Client {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  name      String
  email     String?
  phone     String?
  gstNumber String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@index([name])
  @@map("clients")
}

// ==================== INVOICE MODEL ====================

model Invoice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  clientId      String?  @db.ObjectId
  invoiceNumber String
  invoiceDate   DateTime @default(now())
  dueDate       DateTime?
  status        String   @default("DRAFT")
  gstType       String   @default("CGST_SGST")
  gstRate       Float    @default(18)
  subtotal      Float    @default(0)
  gstAmount     Float    @default(0)
  total         Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([userId, invoiceNumber])
  @@index([userId])
  @@index([status])
  @@index([invoiceDate])
  @@index([clientId])
  @@map("invoices")
}

// ==================== INVOICE ITEM MODEL ====================

model InvoiceItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String   @db.ObjectId
  description String
  hsnCode     String
  quantity    Float    @default(1)
  rate        Float
  amount      Float
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoiceitems")
}

// ==================== PAYMENT MODEL ====================

model Payment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String   @db.ObjectId
  userId    String   @db.ObjectId
  amount    Float
  method    String?
  reference String?
  status    String   @default("PENDING")
  notes     String?
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([userId])
  @@map("payments")
}
