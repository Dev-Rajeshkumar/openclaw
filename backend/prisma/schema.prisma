generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ==================== USER MODEL ====================

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  password       String?  // nullable for Google auth users
  fullName       String
  avatar         String?
  googleId       String?  @unique
  isEmailVerified Boolean @default(false)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businesses     Business[]
  activityLogs   ActivityLog[]

  @@map("users")
}

// ==================== BUSINESS MODEL ====================

model Business {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  name          String
  gstNumber     String?
  phone         String?
  address       String?
  logo          String?
  invoicePrefix String   @default("BB")
  nextInvoiceNo Int      @default(1)
  plan          String   @default("FREE")
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients  Client[]
  invoices Invoice[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("businesses")
}

// ==================== CLIENT MODEL ====================

model Client {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  businessId String  @db.ObjectId
  name      String
  email     String?
  phone     String?
  gstNumber String?
  address   String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@index([businessId])
  @@index([businessId, deletedAt])
  @@map("clients")
}

// ==================== INVOICE MODEL ====================

model Invoice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  businessId    String   @db.ObjectId
  clientId      String?  @db.ObjectId
  invoiceNumber String
  invoiceDate   DateTime @default(now())
  dueDate       DateTime?
  status        String   @default("DRAFT")
  gstType       String   @default("CGST_SGST")
  gstRate       Float    @default(18)
  subtotal      Float    @default(0)
  gstAmount     Float    @default(0)
  total         Float    @default(0)
  notes         String?
  deletedAt     DateTime?
  createdBy     String   @db.ObjectId
  updatedBy     String   @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client   Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]
  statusLogs StatusLog[]

  @@unique([businessId, invoiceNumber])
  @@index([userId])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, deletedAt])
  @@index([status])
  @@index([clientId])
  @@map("invoices")
}

// ==================== INVOICE ITEM MODEL ====================

model InvoiceItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String   @db.ObjectId
  description String
  hsnCode     String
  quantity    Float    @default(1)
  rate        Float
  amount      Float
  deletedAt   DateTime?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoiceitems")
}

// ==================== PAYMENT MODEL ====================

model Payment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String   @db.ObjectId
  userId    String   @db.ObjectId
  amount    Float
  method    String?
  reference String?
  status    String   @default("PENDING")
  notes     String?
  paidAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([userId])
  @@map("payments")
}

// ==================== ACTIVITY LOG MODEL (for internal reference) ====================

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  action      String   // e.g., "CREATE_INVOICE", "UPDATE_CLIENT", "DELETE_INVOICE"
  entity      String   // e.g., "Invoice", "Client", "Business"
  entityId    String?  @db.ObjectId
  method      String   // HTTP method: GET, POST, PUT, DELETE
  path        String   // API endpoint path
  statusCode  Int?     // HTTP response status code
  ip          String?
  userAgent   String?
  requestBody Json?    // sanitized request body
  metadata    Json?    // any additional context
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("activitylogs")
}

// ==================== STATUS LOG MODEL (user-facing audit trail) ====================

model StatusLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  entity      String   // e.g., "Invoice", "Client"
  entityId    String   @db.ObjectId
  action      String   // e.g., "CREATED", "STATUS_CHANGED", "UPDATED"
  oldValue    String?  // previous value (e.g., old status)
  newValue    String?  // new value (e.g., new status)
  description String?  // human-readable description
  changedBy   String   @db.ObjectId
  metadata    Json?    // changes diff, etc.
  createdAt   DateTime @default(now())

  invoice Invoice? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([entityId])
  @@index([changedBy])
  @@index([createdAt])
  @@map("statuslogs")
}
