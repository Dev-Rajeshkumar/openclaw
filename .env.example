# ═══════════════════════════════════════════════════════════════
# CMS Platform — Environment Variable Template
# ═══════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Change ALL placeholder values (change-me, ***, etc.)
#   3. Run:             docker compose up -d
#
# Generate secure keys:
#   openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=1337
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:1337
LOG_LEVEL=info

# ── Strapi Security (REPLACE ALL OF THESE) ───────────────────
APP_KEYS=change-me-key1,change-me-key2
API_TOKEN_SALT=***
ADMIN_JWT_SECRET=***
JWT_SECRET=***
TRANSFER_TOKEN_SALT=***

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://cms_user:***@postgres:5432/cms_db
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=cms_db
DATABASE_USERNAME=cms_user
DATABASE_PASSWORD=***
DATABASE_SSL=false

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ── Search (Meilisearch) ─────────────────────────────────────
MEILI_HOST=http://meilisearch:7700
MEILI_API_KEY=***

# ── Object Storage (MinIO / S3) ──────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=***
MINIO_SECRET_KEY=***
MINIO_BUCKET=cms-media
# For production S3:
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
*** AWS_REGION=us-east-1
# AWS_BUCKET=cms-media

# ── Email (SMTP) ─────────────────────────────────────────────
# Development (Mailpit — catches all emails):
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
DEFAUL….com
DEFAULT_REPLY_TO=noreply@cms.local
# Production:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# ── AI (OpenRouter / Ollama) ─────────────────────────────────
AI_PROVIDER=openrouter
# Get free key: https://openrouter.ai/keys (leave empty to disable AI)
AI_API_KEY=
AI_MODEL=meta-llama/llama-3.1-70b
# Self-hosted Ollama:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:1337

# ── Stripe (Optional — for paywall) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE…RET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── OAuth2 (Optional) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
