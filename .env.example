# ═══════════════════════════════════════════════════════════════
# CMS Platform — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=1337
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:1337
LOG_LEVEL=info

# ── Strapi Security ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
APP_KEYS=key1-change-me,key2-change-me
API_TOKEN_SALT=***
ADMIN_JWT_SECRET=***
JWT_SECRET=***
TRANSFER_TOKEN_SALT=***

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://cms_user:cms_password@localhost:5432/cms_db
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cms_db
DATABASE_USERNAME=cms_user
DATABASE_PASSWORD=***
DATABASE_SSL=false

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Search (Meilisearch) ─────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=***

# ── Object Storage (MinIO / S3) ──────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=***
MINIO_SECRET_KEY=***
MINIO_BUCKET=cms-media
# For production S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=cms-media

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
DEFAULT_REPLY_TO=noreply@yourdomain.com

# ── AI (OpenRouter / Ollama) ─────────────────────────────────
AI_PROVIDER=openrouter
# Get key at: https://openrouter.ai/keys
AI_API_KEY=sk-or-v1-your-key-here
AI_MODEL=meta-llama/llama-3.1-70b
# For Ollama (self-hosted):
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:1337

# ── Stripe (Optional — for paywall) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
